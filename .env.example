# === SAAT DEPLOY KE PRODUKSI (wajib) ======================================
# APP_ENV=production   → CSP & pengaturan produksi aktif otomatis
# APP_DEBUG=false      → true membocorkan stack trace, path server & konfigurasi
# APP_URL=https://...  → https membuat cookie sesi otomatis "Secure" + HSTS aktif
# SESSION_ENCRYPT=true → isi sesi terenkripsi di database
# ===========================================================================
APP_NAME="Rencana Aksi Smart City Banjarmasin"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Content Security Policy: enforce | report | off (default: enforce di produksi,
# off di lokal karena npm run dev memakai skrip inline).
# CSP_MODE=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log menulis email ke storage/logs/laravel.log (tidak terkirim).
# Untuk benar-benar mengirim, ganti ke "smtp" dan isi kredensial di bawah.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SCHEME=tls,
# MAIL_USERNAME=<alamat gmail>, MAIL_PASSWORD=<App Password 16 karakter,
# bukan password biasa — butuh verifikasi 2 langkah aktif di akun Google).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@banjarmasinkota.go.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Alamat SPA (untuk tautan reset password). Kosongkan jika sama dengan APP_URL.
FRONTEND_URL=

# Akun Admin Pusat awal (dibuat oleh AdminPusatSeeder)
ADMIN_PUSAT_NAME="Admin Pusat Diskominfotik"
ADMIN_PUSAT_EMAIL=admin@banjarmasinkota.go.id
ADMIN_PUSAT_PASSWORD=GantiDenganPasswordKuatMinimal10Karakter
